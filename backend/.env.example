# Translation: Sarvam AI only
SARVAM_API_KEY=replace_with_your_sarvam_key
SARVAM_MODEL=sarvam-translate:v1
SARVAM_API_URL=https://api.sarvam.ai/translate

# Visualization: Google Gemini only
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Application
MAX_FILE_SIZE_MB=25
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# Razorpay (set real values only in Render environment variables)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Operations alerts (set only in Render; do not expose to the frontend)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_with_your_webhook
